#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ---- Japanese keycode aliases (kept inline for KeymapEditor) ----
// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt { flavor = "balanced"; };

// ---- Combos (kept inline for KeymapEditor) ----

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        Left_Click {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
        };

        Right_Click {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        Underbar {
            bindings = <&kp JP_UNDERSCORE>;
            key-positions = <24 14>;
        };

        Pipe {
            bindings = <&kp JP_PIPE>;
            key-positions = <13 3>;
        };

        WindowClose {
            layers = <0 4 6 8>;
            bindings = <&kp LG(W)>;
            key-positions = <8 7 9 6>;
        };

        WindowClose_win {
            layers = <1 3 5 7>;
            bindings = <&window_close>;
            key-positions = <8 7 9 6>;
        };

        ContextMenu {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <27 28>;
        };

        Equal {
            bindings = <&kp JP_EQUAL>;
            key-positions = <24 23>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <14 13>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <18 17 16>;
        };

        Asterisk {
            bindings = <&kp JP_ASTERISK>;
            key-positions = <13 23>;
        };
    };
};

// ---- Macros (kept inline for KeymapEditor) ----

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        tkp1: tkp1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp R>;
            label = "TKP1";
        };

        window_close: window_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 500>,
                <&macro_tap>,
                <&kp F4>,
                <&macro_wait_time 500>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WINDOW_CLOSE";
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;

            label = "BT_SELECT_0";
        };

        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;

            label = "BT_SELECT_1";
        };

        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>;

            label = "BT_SELECT_2";
        };

        ScrollLayer_win: ScrollLayer_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_on 7>,
                <&macro_wait_time 100>,
                <&tog_on 9>,
                <&macro_pause_for_release>,
                <&tog_off 7>,
                <&macro_wait_time 100>,
                <&tog_off 9>;

            label = "SCROLLLAYER_WIN";
        };

        ScrollLayer_iOS: ScrollLayer_iOS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_on 8>,
                <&macro_wait_time 100>,
                <&tog_on 9>,
                <&macro_pause_for_release>,
                <&tog_off 8>,
                <&macro_wait_time 100>,
                <&tog_off 9>;

            label = "SCROLLLAYER_IOS";
        };

        iOS_FullScreen: iOS_FullScreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS_FULLSCREEN";
        };

        iOS_Minimize: iOS_Minimize {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp M>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS_MINIMIZE";
        };

        iOS_Split_Left: iOS_Split_Left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp GLOBE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;

            label = "IOS_SPLIT_LEFT";
        };

        iOS_Split_Right: iOS_Split_Right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp GLOBE>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;

            label = "IOS_SPLIT_RIGHT";
        };

        iOS_Split_Up: iOS_Split_Up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp GLOBE>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;

            label = "IOS_SPLIT_UP";
        };

        iOS_Split_Down: iOS_Split_Down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp GLOBE>,
                <&macro_tap>,
                <&kp DOWN_ARROW>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;

            label = "IOS_SPLIT_DOWN";
        };

        iOS_Show_AllWindow: iOS_Show_AllWindow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS_SHOW_ALLWINDOW";
        };

        iOS_NextApp: iOS_NextApp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp RIGHT_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS_NEXTAPP";
        };

        iOS_PrevApp: iOS_PrevApp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "IOS_PREVAPP";
        };

        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>;

            label = "BT_SELECT_3";
        };

        EscGrave: EscGrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&macro_wait_time 200>, <&kp GRAVE>;

            label = "ESCGRAVE";
        };
    };
};

// ---- Custom behaviors (kept inline for KeymapEditor) ----

/ {
    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            // Two fixed wheel units per detent; keep the confirmed direction.

            bindings = <&enc_whl 1>, <&enc_whl 0>;

            tap-ms = <0>;
        };

        enc_whl: encoder_wheel_step {
            compatible = "primeorb,behavior-wheel-step";
            #binding-cells = <1>;
            display-name = "Encoder wheel step (0 down, 1 up)";
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        lt_ScrollLayer_win: lt_ScrollLayer_win {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SCROLLLAYER_WIN";
            bindings = <&ScrollLayer_win>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_ScrollLayer_iOS: lt_ScrollLayer_iOS {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SCROLLLAYER_IOS";
            bindings = <&ScrollLayer_iOS>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        a_tab: a_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "A_TAB";
            bindings = <&kp A>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        LangChange: LangChange {
            compatible = "zmk,behavior-tap-dance";
            label = "LANGCHANGE";
            #binding-cells = <0>;
            bindings = <&lt 2 LANG1>, <&kp LANG2>, <&kp INT4>;
        };

        mod_zy: mod_zy {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_ZY";
            bindings = <&mt LEFT_ALT LC(Z)>, <&kp LC(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT)>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        iOS_default_layer {
            display-name = "iPad JIS";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &lt_ScrollLayer_iOS 0 P
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp MINUS
                &kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp PERIOD
                &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp GLOBE  &lt 4 TAB  &lt_ScrollLayer_iOS 0 SPACE  &kp BACKSPACE  &lt 6 ENTER  &kp DELETE  &lt 2 ESC  &lt_ScrollLayer_iOS 0 SLASH
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        default_layer {
            display-name = "Windows";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &lt_ScrollLayer_win 0 P
                &a_tab  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp MINUS
                &kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp PERIOD
                &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mt LCTRL GRAVE  &lt 3 TAB  &lt_ScrollLayer_win 0 SPACE  &kp BACKSPACE  &lt 5 ENTER  &kp DELETE  &lt 2 ESC  &lt_ScrollLayer_win 0 SLASH
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        win_FUNCTION {
            display-name = "Function";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &kp INSERT  &kp HOME  &kp PAGE_UP  &kp F11  &kp F12  &none  &none  &none  &kp F11  &kp F12
                &kp DELETE  &kp END  &kp PAGE_DOWN  &kp INT4  &kp INT5  &mo 2  &none  &none  &mo 10  &none  &kp INSERT
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        win_SYMBOL {
            display-name = "Win symbols";
            bindings = <
                &kp QUESTION  &kp JP_DQUOTE  &kp EXCLAMATION  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_YEN  &kp JP_AMPERSAND  &kp JP_PIPE  &kp MINUS  &kp JP_EQUAL
                &kp JP_AT  &kp JP_QUOTE  &kp JP_AMPERSAND  &kp JP_LPAREN  &kp JP_RPAREN  &kp LS(HOME)  &kp HOME  &kp UP_ARROW  &kp END  &kp SLASH
                &kp LEFT_SHIFT  &kp JP_TILDE  &kp JP_ASTERISK  &kp JP_LBRACE  &kp JP_RBRACE  &kp LS(END)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp JP_ASTERISK
                &kp LCTRL  &kp JP_CARET  &kp HASH  &kp JP_BACKQUOTE  &kp SEMICOLON  &kp JP_COLON  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp JP_UNDERSCORE
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        iOS_SYMBOL {
            display-name = "iPad symbols";
            bindings = <
                &kp QUESTION  &kp JP_DQUOTE  &kp EXCLAMATION  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_YEN  &kp JP_AMPERSAND  &kp JP_PIPE  &kp MINUS  &kp JP_EQUAL
                &kp JP_AT  &kp JP_QUOTE  &kp JP_AMPERSAND  &kp JP_LPAREN  &kp JP_RPAREN  &kp LS(HOME)  &mkp MB1  &kp UP_ARROW  &kp JP_PLUS  &kp SLASH
                &kp LEFT_SHIFT  &kp JP_TILDE  &kp JP_ASTERISK  &kp JP_LBRACE  &kp JP_RBRACE  &kp LS(END)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp JP_ASTERISK
                &kp LEFT_CONTROL  &kp JP_CARET  &kp HASH  &kp JP_BACKQUOTE  &kp SEMICOLON  &kp JP_COLON  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp JP_UNDERSCORE
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        win_ARROW {
            display-name = "Win arrows";
            bindings = <
                &kp QUESTION  &kp JP_DQUOTE  &kp EXCLAMATION  &kp LESS_THAN  &kp GREATER_THAN  &bt_select_0  &bt_select_1  &bt_select_2  &bt_select_3  &mkp MB4
                &kp JP_AT  &kp JP_QUOTE  &kp JP_AMPERSAND  &kp JP_LPAREN  &kp JP_RPAREN  &kp LS(HOME)  &kp HOME  &kp UP_ARROW  &kp END  &mkp MB5
                &kp LEFT_SHIFT  &kp JP_TILDE  &kp JP_ASTERISK  &kp JP_LBRACE  &kp JP_RBRACE  &kp LS(END)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(Q)
                &kp LEFT_CONTROL  &kp JP_CARET  &kp HASH  &kp JP_BACKQUOTE  &kp SEMICOLON  &kp JP_COLON  &kp LG(L)  &kp ENTER  &kp INTERNATIONAL_4  &kp JP_COLON  &kp JP_UNDERSCORE
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        iOS_ARROW {
            display-name = "iPad arrows";
            bindings = <
                &none  &none  &none  &kp LESS_THAN  &kp GREATER_THAN  &bt_select_0  &bt_select_1  &bt_select_2  &bt_select_3  &kp LG(JP_LBRACKET)
                &none  &none  &none  &none  &none  &kp LC(LEFT_ARROW)  &mkp MB1  &kp UP_ARROW  &mkp MB2  &kp LG(JP_RBRACKET)
                &kp LEFT_SHIFT  &none  &none  &none  &none  &kp LC(RIGHT_ARROW)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT_SHIFT
                &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp JP_BACKQUOTE  &kp SEMICOLON  &kp JP_COLON  &kp LC(LG(Q))  &kp ENTER  &kp LS(LC(RIGHT_ARROW))  &kp LS(LC(LEFT_ARROW))  &kp JP_UNDERSCORE
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        Num {
            display-name = "Win numbers";
            bindings = <
                &kp QUESTION  &kp JP_DQUOTE  &kp LC(LG(LEFT_ARROW))  &kp LG(TAB)  &kp LC(LG(RIGHT_ARROW))  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS  &kp JP_EQUAL
                &kp JP_AT  &kp JP_QUOTE  &kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp JP_PLUS  &kp SLASH
                &kp LEFT_SHIFT  &kp JP_TILDE  &kp LEFT_ARROW  &kp LG(DOWN_ARROW)  &kp RIGHT_ARROW  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &kp JP_ASTERISK
                &kp DOLLAR  &kp LG(E)  &kp HASH  &tkp1  &kp LS(LG(S))  &tog_off 7  &kp BACKSPACE  &kp KP_N0  &kp JP_TILDE  &EscGrave  &kp PERCENT
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        iOS_Num {
            display-name = "iPad numbers";
            bindings = <
                &kp QUESTION  &kp JP_DQUOTE  &iOS_PrevApp  &iOS_Show_AllWindow  &iOS_NextApp  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS  &kp JP_EQUAL
                &kp JP_AT  &kp JP_QUOTE  &iOS_Split_Left  &iOS_Split_Up  &iOS_Split_Right  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp JP_PLUS  &kp SLASH
                &kp LEFT_SHIFT  &kp JP_TILDE  &iOS_Minimize  &iOS_Split_Down  &iOS_FullScreen  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &kp JP_ASTERISK
                &kp DOLLAR  &kp JP_CARET  &kp HASH  &kp LS(LG(NUMBER_4))  &kp LS(LG(NUMBER_3))  &trans  &kp BACKSPACE  &kp KP_N0  &kp KP_N0  &kp JP_TILDE  &kp PERCENT
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        Scroll {
            display-name = "Scroll";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        SettingLayer {
            display-name = "Settings";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LANG2  &kp LANG1  &studio_unlock  &trans  &trans
                &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans  &trans  &trans  &trans  &trans
                &tog_off 1  &tog_on 1  &trans  &out OUT_USB  &out OUT_BLE  &trans  &trans  &trans  &trans  &trans
                &bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    encoder_wheel_listener {
        compatible = "zmk,input-listener";
        device = <&enc_whl>;
    };
};
