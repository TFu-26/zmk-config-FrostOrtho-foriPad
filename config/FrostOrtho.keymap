#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// JIS host mapping. Names describe the character printed by iPad's Japanese layout.
#define JP_DQUOTE LS(N2)
#define JP_AMPERSAND LS(N6)
#define JP_QUOTE LS(N7)
#define JP_EQUAL LS(MINUS)
#define JP_CARET EQUAL
#define JP_YEN INTERNATIONAL_3
#define JP_PLUS LS(SEMICOLON)
#define JP_TILDE LS(EQUAL)
#define JP_PIPE LS(INTERNATIONAL_3)
#define JP_AT LEFT_BRACKET
#define JP_COLON SQT
#define JP_ASTERISK LS(SQT)
#define JP_BACKQUOTE LS(LEFT_BRACKET)
#define JP_UNDERSCORE LS(INTERNATIONAL_1)
#define JP_LBRACKET RIGHT_BRACKET
#define JP_RBRACKET BACKSLASH
#define JP_LPAREN LS(N8)
#define JP_RPAREN LS(N9)
#define JP_LBRACE LS(RIGHT_BRACKET)
#define JP_RBRACE LS(BACKSLASH)

&mt { flavor = "balanced"; quick-tap-ms = <0>; };
&lt { flavor = "balanced"; };

// Mouse clicks extend the auto-mouse layer; typing dismisses it.
&mkp_input_listener { input-processors = <&zip_temp_layer 6 1000>; };

/ {
    // Wheel events have a separate listener: trackball scalers never affect them.
    encoder_wheel_listener {
        compatible = "zmk,input-listener";
        device = <&enc_whl>;
    };

    macros {
        ios_home: ios_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp GLOBE>, <&macro_tap>, <&kp H>,
                       <&macro_release>, <&kp GLOBE>;
        };
    };

    behaviors {
        enc_whl: encoder_wheel_step {
            compatible = "primeorb,behavior-wheel-step";
            #binding-cells = <1>;
            display-name = "Encoder wheel step (0 down, 1 up)";
        };
        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&enc_whl 1>, <&enc_whl 0>;
            tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        ipad_jis {
            display-name = "iPad JIS";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &lt 5 MINUS
                &mt LSHIFT Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp PERIOD  &lt 7 SLASH
                &mt LCTRL TAB  &kp LGUI  &kp LALT  &lt 7 LANG2  &lt 2 SPACE  &lt 3 LANG1  &lt 1 ENTER  &kp BACKSPACE  &kp GLOBE  &lt 4 ESC  &mt RSHIFT INTERNATIONAL_1
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
                &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                &trans  &trans  &trans  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &kp F12
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        number_symbol {
            display-name = "JIS symbols";
            bindings = <
                &kp SLASH  &kp N7  &kp N8  &kp N9  &kp JP_DQUOTE  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp JP_CARET  &kp JP_AT
                &kp MINUS  &kp N4  &kp N5  &kp N6  &kp JP_PLUS  &kp JP_AMPERSAND  &kp JP_QUOTE  &kp JP_LPAREN  &kp JP_RPAREN  &kp JP_LBRACKET
                &mt LSHIFT N0  &kp N1  &kp N2  &kp N3  &kp PERIOD  &kp SEMICOLON  &kp JP_COLON  &kp JP_PIPE  &kp JP_RBRACKET  &kp JP_YEN
                &mt LCTRL JP_EQUAL  &kp ENTER  &trans  &trans  &trans  &trans  &trans  &kp JP_UNDERSCORE  &trans  &kp EXCLAMATION  &kp JP_TILDE
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
                &kp ESC  &trans  &kp UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp LG(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LG(RIGHT)  &trans  &trans  &trans  &trans  &mo 6
                &kp LSHIFT  &trans  &trans  &trans  &trans  &kp LG(UP)  &kp PG_UP  &kp PG_DN  &kp LG(DOWN)  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        settings_layer {
            display-name = "Settings";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &trans  &trans  &trans  &trans  &trans  &out OUT_BLE  &out OUT_USB  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &studio_unlock  &trans  &trans  &trans  &bt BT_CLR
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        vertical_scroll {
            display-name = "Vertical scroll";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        edit_horizontal_scroll {
            display-name = "Edit / horizontal scroll";
            bindings = <
                &kp LG(Z)  &kp LG(LS(Z))  &kp LG(F)  &kp LG(R)  &kp LG(T)  &ios_home  &kp LG(SPACE)  &kp LG(TAB)  &kp LG(W)  &trans
                &kp LG(A)  &kp LG(S)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(LS(N3))  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};
